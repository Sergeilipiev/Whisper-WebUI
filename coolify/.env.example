# ====================================================================
# WHISPER-WEBUI - ENVIRONMENT VARIABLES FOR COOLIFY
# ====================================================================
# Скопируйте эти переменные в Coolify:
# Service → Environment Variables
# ====================================================================

# ==========================================
# ОБЯЗАТЕЛЬНЫЕ
# ==========================================

# HuggingFace Token (для pyannote diarization)
# Получить: https://huggingface.co/settings/tokens
# Принять соглашения:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# GPU НАСТРОЙКИ
# ==========================================

# ID GPU (0 = первая карта)
NVIDIA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=0

# ==========================================
# ОПЦИОНАЛЬНЫЕ
# ==========================================

# Timezone
TZ=Europe/Moscow

# ==========================================
# COOLIFY MAGIC VARIABLES
# ==========================================
# Coolify автоматически создаёт:
# SERVICE_FQDN_WHISPERWEBUI_7860 - URL сервиса
